# A partir de los datos filtrados y limpiados por Paula, crearemos dos heatmap.
# Heatmap de correlación a partir de los grupos de componentes (PCAs)
# Heatmap de expresion a partir de los datos crudos y limpiados por Paula
#========================================================================

```{r, heatmap de componentes principales}
# Heatmap de 6 componentes principales
  
cors <- cor(df_pca %>% select (ADCY3:UHMK1),
            df_pca %>% select(PC1:PC6),
            method="spearman", use = "pairwise.complete.obs")

pheatmap(cors,
         border_color = "grey80", 
         main="Correlación Spearman genes-PCs")

```


  
```{r, Heatmap expresión}
## Heatmap de Expresión génica estandarizada
# Primero organizaremos los datos en una matriz para su correcta visualización y una vez organizados se estandarizarán para un correcto análisis

 mat <- df_clean %>%
  select(ADCY3:UHMK1) %>%
  as.matrix()

mat_z <- scale (mat) #estandarización

pheatmap(mat_z,
  border_color = NA,
  clustering_method = "complete",
  clustering_distance_rows = "euclidean",
  clustering_distance_cols = "euclidean",
  main = "Heatmap expresión génica (z-score) — datos crudos"
)
```

